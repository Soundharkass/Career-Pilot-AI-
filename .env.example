# Copy this file to .env and paste your Google AI Studio Gemini API key.
GEMINI_API_KEY=AQ.Ab8RN6Lw9wA-57EAaudgn3U4kt1To57BFYNaUHLGdo7F9JWAzg
# Gemini Flash model; check Google AI Studio for models available to your account.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_INPUT_TOKENS=6000
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_THINKING_LEVEL=low
GEMINI_FAST_RETRIEVAL=true

# Optional Gemini embedding model used for local knowledge-base retrieval.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional local port
PORT=5000
    
